{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipMac",
  "version": "1.0.1",
  "identifier": "com.clipmac.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "ClipMac",
        "width": 960,
        "height": 620,
        "minWidth": 760,
        "minHeight": 460,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 22 },
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright © 2026 ClipMac contributors. MIT License.",
    "category": "Utility",
    "shortDescription": "Clipboard manager and screenshot tool",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
